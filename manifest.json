{
  "manifest_version": 3,
  "name": "Tarini - Do it for me",
  "short_name": "Tarini",
  "version": "1.5.0",
  "description": "Tarini lives on the right edge of every web page. Open it to ask, learn how, or have it do things for you with your OK.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_title": "Open Tarini",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "sidePanel",
    "tabs",
    "scripting",
    "storage",
    "downloads"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "bubble.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "ask-on-page": {
      "suggested_key": {
        "default": "Alt+T",
        "mac": "Alt+T"
      },
      "description": "Ask Tarini about this page"
    },
    "toggle-dock": {
      "suggested_key": {
        "default": "Alt+Y",
        "mac": "Alt+Y"
      },
      "description": "Open or close the Tarini panel"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "*.woff2",
        "sidepanel.html"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}